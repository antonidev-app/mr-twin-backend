meta {
  name: 3. Select Database
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/admin/accurate/databases/select
  body: formUrlEncoded
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

body:form-urlencoded {
  id_db: 79304
  db_alias: CV TWIN GROUP
}

docs {
  Selects which Accurate database to use, then immediately opens an API
  session (x-session-id + host) against it. After this succeeds, the
  sync commands (accurate:sync-categories, accurate:sync-items) and the
  checkout live-stock check can talk to Accurate.

  Needs an admin token (run Admin > Login first).
}
