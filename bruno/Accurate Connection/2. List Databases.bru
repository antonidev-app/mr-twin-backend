meta {
  name: 2. List Databases
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/admin/accurate/databases
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

docs {
  Lists the Accurate databases (companies) accessible to the connected
  account. Requires step 1 (Connect) to have been completed first, and
  an admin token (run Admin > Login first) — this endpoint reads
  connection state, so it moved under /api/admin once admin auth existed.

  Note the "id" of the database you want (e.g. 79304), then use it in
  "3. Select Database".
}
