meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "budi@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setEnvVar("customer_token", res.body.token);
  }
}

docs {
  Returns a new Sanctum token for an existing customer (old tokens
  stay valid too — login doesn't revoke previous ones). Auto-saves to
  {{customer_token}}.
}
