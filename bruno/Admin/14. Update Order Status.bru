meta {
  name: 14. Update Order Status
  type: http
  seq: 14
}

patch {
  url: {{base_url}}/api/admin/orders/{{order_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "completed"
  }
}

docs {
  Only pending/processing/shipped/completed/cancelled are accepted (422
  otherwise) — this is the only place an order's status ever changes;
  checkout always creates it as "pending".

  If the status actually changes (no-op PATCHes with the same status
  don't), the customer is queued an email (App\Mail\OrderStatusUpdatedMail)
  via the `database` queue — needs `php artisan queue:work` running to
  actually be delivered. Locally with MAIL_MAILER=log the rendered email
  lands in storage/logs/laravel.log instead of a real inbox.
}
