meta {
  name: 1. Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/admin/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@mrtwin.test",
    "password": "password12345"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setEnvVar("admin_token", res.body.token);
  }
}

docs {
  No public registration for admin accounts — create one first via
  tinker (see the backend README's "Admin account" section), then log
  in here. Auto-saves the token to {{admin_token}}.
}
