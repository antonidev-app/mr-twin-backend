meta {
  name: Get Order
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/orders/{{order_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customer_token}}
}

docs {
  Returns 404 (not 403) if the order exists but belongs to a different
  customer — this is deliberate, so a non-owner can't even tell the
  order exists (avoids ID-enumeration signal).
}
